{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capability for autostand main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "shell:default",
    "store:default"
  ]
}
