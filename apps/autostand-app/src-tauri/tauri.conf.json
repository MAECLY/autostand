{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autostand",
  "version": "1.2.0",
  "identifier": "com.miguel50flowers.autostand",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "autostand",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Daily standup automation",
    "longDescription": "Cross-platform daily standup automation with pluggable AI providers and data sources.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MEJENEY4ODU4RTgwNEQKUldSTmdJNkYrTlFMbFZEZ0NtS01wUFA2VkNPVlBFeFljTXgyY3Vtc0EwcXAvOG5TMUNuS09VbXMK",
      "endpoints": [
        "https://github.com/MAECLY/autostand/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
