---
/**
 * An illustration of the autostand dashboard.
 *
 * There is no released binary to screenshot, so this is a recreation rather than
 * a picture: same design-system components, same tokens, same layout as
 * `apps/autostand-app/src/routes/index.tsx`. Built that way it restyles with the
 * theme and cannot quietly drift into showing a UI the product does not have —
 * which a stale PNG would. The content is example data in the real file grammar
 * (`docs/specs/standup-file-format.md`).
 *
 * Nothing inside is interactive: the whole frame is exposed as a single image,
 * so a focusable control in here would be reachable by keyboard yet invisible to
 * a screen reader.
 */

import { Badge } from "@design-system/components/badge";
import { buttonVariants } from "@design-system/components/button";
import { Card, CardContent, CardHeader } from "@design-system/components/card";
import { Progress } from "@design-system/components/progress";
import { Play } from "lucide-react";

export interface Props {
  /** Extra classes for the outer figure, so the placing section owns its margins. */
  class?: string;
}

const { class: className } = Astro.props;
// BASE_URL is "/autostand" here — no trailing slash — so normalise rather than
// concatenating and getting "/autostandbrand/…".
const markSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/brand/logo-mark.svg`;

const MOCKUP_LABEL =
  "Illustration of the autostand dashboard: a desktop window titled autostand, " +
  "showing the standup filed for August 3 2026, an AUTO block owned by the host " +
  "MacStudio-de-Miguel with bullets gathered from commits and a pull request review, " +
  "a manual block badged “never overwritten”, and a pipeline card reporting a finished run.";
---

<figure class:list={["flex flex-col gap-3", className]}>
  <div
    role="img"
    aria-label={MOCKUP_LABEL}
    class="overflow-hidden rounded-xl border border-border bg-surface shadow-lg"
  >
    {/* Window chrome */}
    <div class="flex items-center gap-3 border-b border-border bg-elevated px-4 py-3">
      <div class="flex shrink-0 gap-1.5">
        <span class="size-3 rounded-full bg-destructive"></span>
        <span class="size-3 rounded-full bg-warning"></span>
        <span class="size-3 rounded-full bg-success"></span>
      </div>
      <div class="flex flex-1 items-center justify-center gap-2">
        <img
          src={markSrc}
          alt=""
          width="16"
          height="16"
          class="size-4 rounded-sm"
        />
        <span class="text-sm font-medium text-muted-foreground">autostand</span>
      </div>
      {/* Balances the traffic lights so the title stays optically centred. */}
      <div class="w-14 shrink-0"></div>
    </div>

    {/* Dashboard */}
    <div class="flex flex-col gap-4 bg-background p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-base font-semibold text-foreground">Today — August 03, 2026</p>
          <p class="text-sm text-muted-foreground">
            Filed as <span class="font-mono">2026-08-03</span> in the dailies directory.
          </p>
        </div>
        {/* A picture of the "Compile now" button, not a button. */}
        <span class={buttonVariants({ size: "sm" })}>
          <Play aria-hidden="true" />
          Compile now
        </span>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="flex flex-col gap-4 md:col-span-2">
          {/* Headings here would land in the page outline between the hero h1 and
              the section h2s, so the file title is a paragraph carrying the same
              type scale as the app's heading. */}
          <div class="flex flex-col gap-1">
            <p class="text-lg font-semibold text-foreground">
              Daily Standup — August 03, 2026
            </p>
            <p class="text-sm text-muted-foreground">
              Work completed August 01–02, 2026.
            </p>
          </div>

          {/* The local host's block is ringed, exactly as the app marks it. */}
          <Card className="ring-1 ring-ring">
            <CardHeader className="flex flex-row items-center justify-between gap-2 p-4">
              {/* text-muted-foreground rather than text-subtle: slate-400 on a card
                  is 2.56:1, under the 4.5:1 this label needs at 14px. */}
              <span class="text-sm font-medium text-muted-foreground">Auto</span>
              <Badge className="font-mono">MacStudio-de-Miguel</Badge>
            </CardHeader>
            <CardContent className="flex flex-col gap-3 p-4 pt-0 text-sm text-foreground">
              <div class="flex flex-col gap-1">
                <p class="font-semibold">autostand — Scheduler</p>
                <ul class="list-disc space-y-1 pl-5">
                  <li class="leading-relaxed">
                    Implemented the cron parser and
                    <code class="rounded-sm bg-inset px-1 py-0.5 font-mono">next_run</code>
                    (5-field POSIX subset)
                  </li>
                  <li class="leading-relaxed">
                    Filled the previous business day from disk on a missed run
                  </li>
                </ul>
              </div>
              <div class="flex flex-col gap-1">
                <p class="font-semibold">PR Review</p>
                <ul class="list-disc space-y-1 pl-5">
                  <li class="leading-relaxed">
                    autostand #12 — “Add IPC contracts” — Approved
                  </li>
                </ul>
              </div>
            </CardContent>
          </Card>

          <Card>
            {/* bg-muted, not bg-warning-bg: --status-warning-bg is amber-50 and the
                `.dark` block never overrides it, so a warning band would stay a
                near-white stripe inside a dark card. bg-muted flips with the theme;
                the amber signal still lands, on the badge. */}
            <CardHeader
              className="flex flex-row items-center justify-between gap-2 rounded-t-lg bg-muted p-4"
            >
              <span class="text-sm font-medium text-foreground">Manual</span>
              <Badge variant="warning">never overwritten</Badge>
            </CardHeader>
            <CardContent className="p-4 pt-0 text-sm text-foreground">
              <ul class="list-disc space-y-1 pl-5">
                <li class="leading-relaxed">Attended architecture review at 14:00</li>
              </ul>
            </CardContent>
          </Card>
        </div>

        <Card className="h-fit">
          <CardHeader className="flex flex-row items-center justify-between gap-2 p-4">
            <span class="text-sm font-medium text-muted-foreground">Pipeline</span>
            <Badge variant="success">done</Badge>
          </CardHeader>
          <CardContent className="flex flex-col gap-3 p-4 pt-0">
            <Progress value={100} />
            <div class="flex items-center justify-between text-sm">
              <span class="font-mono text-muted-foreground">write_file</span>
              <span class="font-mono text-muted-foreground">100%</span>
            </div>
            <p class="text-sm text-muted-foreground">Last run 2 minutes ago</p>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>

  <figcaption class="text-center text-sm text-muted-foreground">
    An illustration of the dashboard, drawn with the app's own components and tokens.
    Content is an example.
  </figcaption>
</figure>
