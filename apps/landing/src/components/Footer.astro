---
// Inlined (?raw) instead of loaded through <img>: logo-mono.svg paints with
// `currentColor`, which an <img> cannot inherit — inline markup lets the text
// colour class on the wrapper drive it, so the mark stays legible in both themes.
import logoMono from "../../../../brand/logo/logo-mono.svg?raw";

const REPO_URL = "https://github.com/MAECLY/autostand";

const links = [
  { href: REPO_URL, label: "Repository" },
  { href: `${REPO_URL}/tree/main/docs`, label: "Documentation" },
  { href: `${REPO_URL}#license`, label: "MIT license" },
] as const;

// Build-time year: the page is static, so this is stamped on each deploy.
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <span class="block text-foreground [&>svg]:h-7 [&>svg]:w-auto" set:html={logoMono} />
        <p class="mt-4 text-base font-medium text-foreground">
          Automate your standup. Know what you did.
        </p>
        <p class="mt-2 text-sm text-muted-foreground">
          Runs on your machine. No account, no telemetry.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-3 md:items-end">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-sm text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-sm text-muted-foreground">
      &copy; {year} autostand contributors. MIT licensed. Built in the open on GitHub.
    </p>
  </div>
</footer>
