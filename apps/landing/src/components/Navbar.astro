---
// Inlined (?raw) instead of loaded through <img>: the wordmark path in
// logo-horizontal.svg ships a fixed dark fill, which vanishes on the dark theme.
// Inline markup lets `fill-current` hand that one path to the theme token while
// the mark keeps its brand blue. The SVG carries role="img" + aria-label, so it
// names itself the way an <img> alt would.
import logoHorizontal from "../../../../brand/logo/logo-horizontal.svg?raw";
import { Menu, X } from "lucide-react";

import { buttonVariants } from "@design-system/components/button";

import { ThemeToggle } from "@/components/ThemeToggle";

const REPO_URL = "https://github.com/MAECLY/autostand";

const sections = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#audit", label: "Audit" },
  { href: "#faq", label: "FAQ" },
] as const;
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/85 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:gap-4 sm:px-6 lg:px-8">
    {/* "#top" scrolls to the document element even with no #top in the page — HTML
        spec behaviour — so the logo works no matter how the page is assembled. */}
    <a
      href="#top"
      class="shrink-0 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <span
        class="block h-7 text-foreground sm:h-8 [&>svg>path]:fill-current [&>svg]:h-full [&>svg]:w-auto"
        set:html={logoHorizontal}
      />
    </a>

    <nav aria-label="Main" class="ml-6 hidden items-center gap-6 md:flex">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="rounded-sm text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <ThemeToggle client:load />

      {/* The wrapper carries the responsive display: `hidden` on the anchor itself
          would lose to the button's own `inline-flex`, which Tailwind emits later. */}
      <div class="hidden sm:block">
        <a href={REPO_URL} class={buttonVariants({ size: "sm" })}>Get it on GitHub</a>
      </div>

      {/* Native disclosure: the mobile menu needs no island, and it still works
          if the enhancement script below fails to load. */}
      <details id="mobile-menu" class="group md:hidden">
        <summary
          aria-label="Menu"
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition-colors hover:bg-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden"><Menu aria-hidden="true" className="size-5" /></span>
          <span class="hidden group-open:block"><X aria-hidden="true" className="size-5" /></span>
        </summary>

        <nav
          aria-label="Mobile"
          class="absolute inset-x-0 top-16 flex flex-col gap-1 border-b border-border bg-surface p-4 shadow-md"
        >
          {
            sections.map((section) => (
              <a
                href={section.href}
                class="rounded-md px-3 py-2 text-base font-medium text-foreground transition-colors hover:bg-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                {section.label}
              </a>
            ))
          }
          <a href={REPO_URL} class={`mt-2 ${buttonVariants({ size: "default" })}`}>
            Get it on GitHub
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // An in-page anchor does not reload the document, so the open disclosure would
  // stay on top of the section it just scrolled to. Close it after a jump.
  const menu = document.getElementById("mobile-menu");

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => menu.removeAttribute("open"));
  });
</script>
