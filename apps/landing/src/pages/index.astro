---
/**
 * The landing page. Section order comes from
 * `docs/design-system/06-landing-reuse.md` § Landing page sections, minus the
 * pricing row it lists: autostand has no pricing, no account and no release, so
 * there is nothing honest to put there.
 *
 * Composition only. Every section owns its own container and vertical rhythm
 * (see the layout contract in each file), so `<main>` stays bare — adding a
 * container here would double the padding and re-clamp the width.
 *
 * Islands: `ThemeToggle` is hydrated inside `Navbar.astro` with `client:load`,
 * because it has to match the class the pre-paint script already stamped on
 * <html>. `Faq` is Radix and needs `client:visible` — below the fold, and a
 * panel that cannot open is worse than no panel. Everything else is static
 * markup rendered to HTML at build time and ships no JavaScript.
 */

import { AuditDemo } from "@/components/AuditDemo";
import { Faq } from "@/components/Faq";
import Features from "@/components/Features.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import Navbar from "@/components/Navbar.astro";
import Base from "@/layouts/Base.astro";

const TITLE = "autostand — Automate your standup. Know what you did.";
// Not "eight local sources": the github adapter shells out to the `gh` CLI, which
// reaches GitHub's API. The sources are eight; only seven of them are offline.
const DESCRIPTION =
  "autostand gathers your commits, pull requests and notes from eight sources, renders them, writes them into your dated standup file and pushes it. Local-first, open source, MIT licensed.";
---

<Base title={TITLE} description={DESCRIPTION}>
  {/* First focusable element in the document: a keyboard visitor should be able
      to jump the sticky nav instead of tabbing through it on every visit.
      Parked above the viewport rather than `sr-only`, because `not-sr-only`
      resets padding and the link would land on screen with its text flush
      against the edges. `fixed` so it works at any scroll offset; z above the
      header's z-50. */}
  <a
    href="#main"
    class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-md transition-transform focus:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  >
    Skip to content
  </a>

  <Navbar />

  <main id="main">
    <Hero />
    <Features />
    {/* Tonal band: the pipeline is the middle of the story, and a surface strip
        separates it from the two background-coloured sections around it. */}
    <HowItWorks class="border-y border-border bg-surface" />
    <AuditDemo />
    <Faq client:visible className="border-t border-border" />
  </main>

  <Footer />
</Base>
